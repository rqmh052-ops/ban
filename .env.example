# انسخ المتغيرات دي في إعدادات Railway -> Variables
# (مش هتحتاج تعمل ملف .env فعلي - Railway بيحقن المتغيرات مباشرة)

# توكن البوت من BotFather
BOT_TOKEN=123456:ABC-your-bot-token-here

# آيديك الشخصي على تيليجرام - أنت السوبر أونر (الأدمن الأعلى) للبوت كله
# عندك صلاحية إدارة كل القنوات المربوطة، بغض النظر عن مين ضافها
OWNER_ID=8287678319

# بيتحط تلقائيًا من Railway لما تضيف PostgreSQL Plugin - متحتاجش تكتبه إنت
# DATABASE_URL=postgresql://...

# ---------------------------------------------------------------------------
# ملحوظة مهمة: متغير CHANNEL_ID القديم اتشال نهائياً من هذه النسخة.
# البوت دلوقتي multi-channel: أي شخص يقدر يربط قناته الخاصة عن طريق
# زرار "ربط قناة جديدة" داخل اللوحة (يضغط /start في الخاص مع البوت)،
# يختار القناة من قائمة قنواته، ويأكد ترقية البوت لأدمن بصلاحية الحظر.
# البوت بعدها يكتشف نفسه تلقائياً ويبدأ الحماية على القناة المختارة فوراً.
# ---------------------------------------------------------------------------
